# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Never expose to client

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret: https://dashboard.stripe.com/webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs: create in Stripe dashboard → Products → Packet Day Unlimited → price ID
# STRIPE_PRICE_MONTHLY → $12/mo plan on /pricing
# STRIPE_PRICE_YEARLY  → $108/yr plan on /pricing
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Replicate ──────────────────────────────────────────────────────────────────
# Get from: https://replicate.com/account/api-tokens
# Used for AI mascot image generation (black-forest-labs/flux-schnell)
# Optional — if missing, mascot images will be skipped gracefully
REPLICATE_API_TOKEN=r8_...

# ─── Resend ────────────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Also verify your domain at: https://resend.com/domains
RESEND_API_KEY=re_...

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: NEXT_PUBLIC_APP_URL=https://www.packetday.com

# ─── Email sequence / unsubscribe ───────────────────────────────────────────────
# Strong random signing secret for unsubscribe-link tokens (lib/unsubscribe.ts).
# Never reused for anything else. Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=change-me

# Physical mailing address shown in marketing email footers (CAN-SPAM). Must be
# a real address before any marketing email sends — lib/emailFooter.ts's
# assertMailingAddressReady() throws while this is still the placeholder below.
MAILING_ADDRESS=ADDRESS PENDING

# ─── Email sequence engine (Phase 4) ────────────────────────────────────────────
# ISO timestamp. Only profiles with created_at >= this are enrolled in the
# welcome/nurture sequence. Leave unset -- unset means nobody is enrolled.
# EMAIL_LAUNCH_AT=2026-10-01T00:00:00Z

# When not exactly "true", app/api/cron/email-sequence and the confirm route's
# welcome_1 send always run as a dry run / no-op.
EMAIL_SEQUENCE_ENABLED=false

# Bearer secret app/api/cron/email-sequence/route.ts requires on every
# request. Vercel Cron sends it automatically once set as a project env var.
# Generate with: openssl rand -hex 32. Never commit the real value.
CRON_SECRET=change-me

# Comma separated exact email addresses that bypass the adrdefi exclusion
# and the launch cutoff (not opt-out, paid checks, or collision rules) --
# for Phase 6's backdated test accounts. Empty for now.
EMAIL_TEST_ALLOWLIST=
